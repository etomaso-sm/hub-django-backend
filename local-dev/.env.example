# Local dev environment. Copy to .env and fill in the values you need.
#
# `make local-up` reads this via docker-compose's built-in ${VAR:-default}
# resolution, so missing values fall back to safe defaults.

# --- DB / cache (must match docker-compose.yml internal service names) ---
DATABASE_URL=postgres://hub:hub@localhost:5432/hub
REDIS_URL=redis://localhost:6379/0

# --- Host ports ---
POSTGRES_PORT=5432
REDIS_PORT=6379
CADDY_PORT=8080
MOCK_LEGACY_PORT=8787
DJANGO_PORT=8000

# --- Django ---
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_SETTINGS_MODULE=hub.settings.dev

# --- Local auth convenience ---
# When set AND Django is in DEBUG, HubAuthentication resolves this email to
# a People row on every request (bypasses CF Access locally).
# Must match an email in fixtures/seed_hub_sprint_mode.json.
DEV_BYPASS_AUTH_AS_EMAIL=staff@local.test

# --- Cloudflare Access (prod flow; leave empty locally) ---
CF_ACCESS_TEAM=
CF_ACCESS_AUD=
CF_ACCESS_JWKS_URL=

# --- Anthropic (needed for TKT-054 onward; not referenced before that) ---
ANTHROPIC_API_KEY=
