	$(MAKE) -C .. verify-TKT-018

verify-TKT-019:
	$(MAKE) -C .. verify-TKT-019

verify-TKT-020:
	$(MAKE) -C .. verify-TKT-020

verify-TKT-021:
	$(MAKE) -C .. verify-TKT-021

verify-TKT-022:
	$(MAKE) -C .. verify-TKT-022

verify-TKT-023:
	$(MAKE) -C .. verify-TKT-023

verify-ticket:
